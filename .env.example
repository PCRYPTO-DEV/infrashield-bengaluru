DATABASE_URL=postgresql://infrashield:infrashield@db:5432/infrashield
ENVIRONMENT=development
SQLITE_DB_PATH=infrashield.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- X account manager agent (x_agent/) ---
ANTHROPIC_API_KEY=
X_AGENT_MODEL=claude-opus-5-5
X_AGENT_EFFORT=medium
# dryrun | x | typefully
X_AGENT_PUBLISHER=dryrun
X_AGENT_AUTO_PUBLISH_POSTS=false
X_AGENT_MAX_POSTS_PER_RUN=3
X_AGENT_TIMEZONE=Asia/Kolkata
# X API v2 (developer.x.com -> project -> app -> keys; app needs Read and Write)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
# Optional: publish through Typefully instead of the X API
TYPEFULLY_API_KEY=
