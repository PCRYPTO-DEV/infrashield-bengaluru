# Copy to server/.env (never commit the real file)
TOMTOM_API_KEY=
ANTHROPIC_API_KEY=
# Region served by default: ncr | bengaluru
ATLAS_REGION=ncr
# Where tile and feed caches live (SQLite). Defaults to server/data/atlas.db
ATLAS_DATA_DIR=
# Set to a folder of recorded responses to run without network (tests, demos)
ATLAS_FIXTURES=
# Upper bound on TomTom calls per UTC day (free tier is 2500)
TOMTOM_DAILY_BUDGET=2000
